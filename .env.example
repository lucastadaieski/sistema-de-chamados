# Copie este arquivo para ".env" e preencha. O .env não vai para o GitHub.

# Conexão do MongoDB Atlas (pode ser o mesmo cluster do Login Seguro)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Chave do token JWT: precisa ser IGUAL à JWT_SECRET do Login Seguro
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
